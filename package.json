{
    "name": "@unsass/breakpoint",
    "version": "2.8.0",
    "description": "Composable Sass mixins and utilities for centralized, maintainable media-query breakpoints.",
    "type": "module",
    "scripts": {
        "lint:css": "stylelint --fix \"**/*.scss\"",
        "lint": "npm-run-all --parallel lint:*",
        "test": "vitest",
        "prepare": "husky",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=22"
    },
    "sass": "index.scss",
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "sass": "^1.104.1",
        "sass-true": "^10.1.0",
        "semantic-release": "^25.0.9",
        "stylelint": "^16.26.1",
        "stylelint-config-unsass": "^2.3.0",
        "vitest": "^5.0.1"
    },
    "peerDependencies": {
        "sass": ">=1.95.0"
    },
    "keywords": [
        "sass",
        "scss",
        "breakpoint",
        "responsive",
        "media queries",
        "media query",
        "mixins",
        "unsass",
        "front-end"
    ],
    "author": "Front Factory",
    "license": "MIT",
    "homepage": "https://github.com/unsass/breakpoint#readme",
    "bugs": {
        "url": "https://github.com/unsass/breakpoint/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unsass/breakpoint.git"
    },
    "files": [
        "src/**/*",
        "*.scss",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
